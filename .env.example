# Copy this file to .env for local development. Never commit real secrets.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Primary script provider: Groq. Keep this key only in the backend environment.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Backup provider and Google Search-grounded fact-check provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=https://reel-pilot-ai.vercel.app,http://localhost:5173

# Other integrations (not configured yet).
FIREBASE_PROJECT_ID=
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
