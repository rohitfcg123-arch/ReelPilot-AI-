# Copy this file to .env for local development. Never commit real secrets.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Gemini API key must exist only in the backend deployment environment.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=https://reel-pilot-ai.vercel.app,http://localhost:5173

# Other integrations (not configured yet).
FIREBASE_PROJECT_ID=
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
